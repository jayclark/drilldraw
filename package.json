{
  "name": "drilldraw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server/src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"tsx watch src/server.ts\" \"vite --config client/vite.config.ts\"",
    "build": "tsc -p tsconfig.build.json && vite build --config client/vite.config.ts",
    "start": "node dist/server/src/server.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p client/tsconfig.json",
    "test": "node --test --import tsx \"src/**/*.test.ts\" && vitest run --config client/vite.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/identity": "^4.14.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "lib0": "^0.2.120",
    "nanoid": "^6.0.2",
    "ws": "^8.23.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jspdf": "^4.2.1",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "svg2pdf.js": "^2.9.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "y-websocket": "^3.1.0"
  }
}
